{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": [".claude/dev-server.mjs"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Next.js Dev (Turbopack)",
      "runtimeExecutable": "pnpm",
